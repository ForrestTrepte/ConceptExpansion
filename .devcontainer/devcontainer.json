{
  "name": "concept-expansion",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  // Install uv and create the project environment in .venv from uv.lock.
  "postCreateCommand": "pipx install uv && uv sync",
  // The uv cache and the workspace are on different filesystems, so uv can't hardlink.
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
